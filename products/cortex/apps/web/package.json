{
  "name": "@cortex/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run contracts:check && next build --webpack",
    "build:app": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts": "UV_CACHE_DIR=../../../../.uv-cache uv run python scripts/export-openapi.py && openapi-zod-client openapi.json -o lib/generated/api.ts --export-schemas --template scripts/api-client.hbs && prettier --write openapi.json lib/generated/api.ts",
    "contracts:check": "npm run contracts && git diff --exit-code -- openapi.json lib/generated/api.ts"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "26.1.0",
    "openapi-zod-client": "1.18.3",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
