# Copy to .env for local development. These defaults match docker-compose.yml.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5432/brain

# Local development only. Replace this disposable example value when needed.
LOCAL_BEARER_TOKEN=brain-local-dev
LOCAL_ORGANIZATION_ID=10000000-0000-0000-0000-000000000001
LOCAL_PRINCIPAL_ID=20000000-0000-0000-0000-000000000001
LOCAL_GROUP_IDS=[]

# Optional host bindings for Compose.
POSTGRES_PORT=5432
API_PORT=8000
