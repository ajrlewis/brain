# Copy to .env for local development. These defaults match docker-compose.yml.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5432/brain
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000

# Local development only. Replace this disposable example value when needed.
LOCAL_BEARER_TOKEN=brain-local-dev
# These deterministic IDs match Alex and the investment team in the Northstar seed.
LOCAL_ORGANIZATION_ID=35982da3-60ae-5eea-b46a-088c3cc0f278
LOCAL_PRINCIPAL_ID=7f180c45-c2f9-5f9d-b715-bf68f4ced724
LOCAL_GROUP_IDS=["8bde0934-4daa-5afa-a9c3-24e849557486"]

# Optional host bindings for Compose.
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
CORTEX_API_PORT=8100
CORTEX_WEB_PORT=3100

# Cortex's server-only Brain integration. Compose uses http://api:8000 internally.
BRAIN_URL=http://127.0.0.1:8000
BRAIN_API_KEY=brain-local-dev
BRAIN_CONNECT_TIMEOUT_SECONDS=2
BRAIN_READ_TIMEOUT_SECONDS=5

# Cortex model backend. Deterministic is hermetic; OpenAI requires API key and model.
MODEL_BACKEND=deterministic
OPENAI_TIMEOUT_SECONDS=30
# OPENAI_API_KEY
# OPENAI_MODEL
# Optional OpenAI-compatible endpoint and account routing.
# OPENAI_BASE_URL
# OPENAI_ORGANIZATION
# OPENAI_PROJECT

# Local web sign-in. Development only; use a production identity provider later.
BRAIN_API_URL=http://127.0.0.1:8000
LOCAL_WEB_USER=brain-admin
LOCAL_WEB_PASSWORD=brain-local-dev
LOCAL_WEB_SESSION_SECRET=brain-local-session-secret
